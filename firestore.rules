rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'updatedAt']) &&
             data.keys().size() <= 4 &&
             data.userId == request.auth.uid &&
             data.updatedAt == request.time;
    }

    function isValidHistory(data) {
      return data.keys().hasAll(['userId', 'query', 'answer', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.query is string && data.query.size() <= 2000 &&
             data.answer is string && data.answer.size() <= 10000 &&
             data.timestamp == request.time;
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['userId', 'queryId', 'rating', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.queryId is string &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.timestamp == request.time;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read, write: if isOwner(userId) && (request.method != 'create' || isValidUser(incoming()));
    }

    match /history/{historyId} {
      allow create: if isSignedIn() && isValidHistory(incoming());
      allow list, get, delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && isValidFeedback(incoming());
      allow list, get: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
